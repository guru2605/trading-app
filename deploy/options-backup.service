# Daily capture-DB snapshot — TEMPLATE, copy to /etc/systemd/system/ on the Linode.
# Runs after the capture window (10:20 IST); safe on non-trading days (idempotent, tiny).

[Unit]
Description=Snapshot the options capture database (gzip, 60-day rotation)
OnFailure=options-notify-failure@%n.service

[Service]
Type=oneshot
User=trader
WorkingDirectory=/home/trader/trading-app
ExecStart=/home/trader/trading-app/.venv/bin/python deploy/backup_capture.py
Nice=10

[Install]
WantedBy=multi-user.target
